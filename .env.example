# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# ---- PostgreSQL (the real database; DataGrip connects to this same instance) ----
POSTGRES_USER=wc26
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wc26_forecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy / Alembic connection URL (psycopg v3 driver).
# Must stay consistent with the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://wc26:change_me@localhost:5432/wc26_forecast

# ---- Reproducibility ----
# Global random seed persisted in every model_run / tournament_simulation (addendum §8).
RANDOM_SEED=20260611

# ---- Data governance ----
# Immutable raw snapshots live here; tracked by manifest + SHA-256, not by git (addendum §8/§14).
DATA_RAW_DIR=data/raw
