{
  "name": "wc26-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phase 14 — minimal React UI over the World Cup 2026 forecast API (honest uncertainty).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "npx --yes openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/openapi.d.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
